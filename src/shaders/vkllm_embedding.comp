#version 450 core
#include "vkllm_shader_header.comp.h"

layout(push_constant) uniform constants
{
    ShapeConstant indices_shape;
    ShapeConstant params_shape;
    ShapeConstant output_shape;
    uint UNK_TOK;
};

layout(binding = 0) readonly buffer Indices
{
    uint indices[];
};

layout(binding = 1) readonly buffer Params
{
    DTYPE params[];
};

layout(binding = 2) writeonly buffer Out
{
    DTYPE output0[];
};

void get_indices(uint tid, in out uint b, out uint c, out uint h, out uint w)
{
    uint cn = indices_shape.shapes[2] * indices_shape.shapes[3];
    uint bn = indices_shape.shapes[1] * cn;
    b = tid / bn;
    uint b_offset = b * bn;

    c = (tid - b_offset) / cn;
    uint c_offset = c * cn;

    h = (tid - b_offset - c_offset) / indices_shape.shapes[3];
    w = tid - b_offset - c_offset - h * indices_shape.shapes[3];
}

void main(void)
{
    // The host dispatches num_tokens * dim threads; thread tid maps to
    // (token, element) = (tid / dim, tid % dim) so the row copy is parallel
    // across the hidden dim. (The original one-thread-per-token loop
    // serialized the whole row through a single lane — ~200us for 8KB.)
    uint tid = get_thread_id();
    uint n_tokens = indices_shape.shapes[0] * indices_shape.shapes[1] * indices_shape.shapes[2] *
                    indices_shape.shapes[3];
    uint dim = params_shape.shapes[3];
    if (tid >= n_tokens * dim)
    {
        return;
    }

    uint row = tid / dim;
    uint w = tid - row * dim;

    uint tok = indices[row];
    if (tok >= params_shape.shapes[2])
    {
        tok = UNK_TOK;
    }

    // Output addressing via the pushed strides (rows may have padding);
    // the params table rows are indexed directly by token id.
    uint seq = indices_shape.shapes[3];
    uint b = row / (indices_shape.shapes[2] * seq);
    uint rem = row - b * indices_shape.shapes[2] * seq;
    uint h = rem / seq;
    uint t = rem - h * seq;
    uint out_off = b * output_shape.strides[0] + h * output_shape.strides[1] + t * output_shape.strides[2];
    output0[out_off + w] = params[tok * params_shape.strides[2] + w];
}
