#version 450 core
#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#ifdef _SUPPORT_FLOAT16_ARITHMETIC
#extension GL_EXT_shader_subgroup_extended_types_float16 : require
#endif

#include "vkllm_shader_header.comp.h"

layout(binding = 0) readonly buffer in0_type
{
    DTYPE in_vec[];
};

layout(binding = 1) readonly buffer in1_type
{
    DTYPE in_mat[];
};

#ifdef _SUPPORT_16BIT_STORAGE
// Vectorized aliases over the same buffer: with a unit row pitch
// (strides[3] == 1) rows are consumed four elements per memory op.
layout(binding = 0) readonly buffer in0_type_v4
{
    f16vec4 in_vec_v4[];
};
layout(binding = 1) readonly buffer in1_type_v4
{
    f16vec4 in_mat_v4[];
};
#endif

layout(binding = 2) writeonly buffer out0_type
{
    DTYPE out_mat[];
};

layout(push_constant) uniform constants
{
    ShapeConstant shape_vec;
    ShapeConstant shape_mat;
    ShapeConstant shape_out;

    float scale;
    int act;
};

#define BOARDCAST_AXIS0 0
#define BOARDCAST_AXIS1 1
#define BOARDCAST_AXIS01 2
#define BOARDCAST_NONE 3

layout(constant_id = 0) const int a_boardcast_type = 0;
layout(constant_id = 1) const int b_boardcast_type = 0;

// Each subgroup computes TWO adjacent weight rows (row pair), sharing the
// activation loads between them.

void main()
{
    // Workgroup linear id -> first row of this subgroup's row PAIR, in the
    // flattened [b, c, h, w] output space (w is the matrix row / N dim).
    // One subgroup computes two adjacent weight rows; the activation strip
    // each lane reads is shared by both rows (activation traffic halves and
    // the two weight rows hit adjacent cache lines).
    uint wg = gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z;
    uint row0 = wg * 2;

    uint n_total = shape_out.shapes[2] * shape_out.shapes[3];
    uint row_idx = row0;

    uint b = row_idx / (shape_out.shapes[1] * n_total);
    uint rem = row_idx - b * shape_out.shapes[1] * n_total;
    uint c = rem / n_total;
    uint hw = rem - c * n_total;
    uint h = hw / shape_out.shapes[3];
    uint w = hw - h * shape_out.shapes[3];

    if (b >= shape_out.shapes[0] || c >= shape_out.shapes[1] || h >= shape_out.shapes[2] ||
        w >= shape_out.shapes[3])
    {
        return;
    }

    uint a_batch_off = 0;
    uint b_batch_off = 0;
    if (a_boardcast_type == BOARDCAST_AXIS0)
    {
        a_batch_off = c * shape_vec.strides[1];
    }
    else if (a_boardcast_type == BOARDCAST_AXIS1)
    {
        a_batch_off = b * shape_vec.strides[0];
    }
    else if (a_boardcast_type == BOARDCAST_NONE)
    {
        a_batch_off = b * shape_vec.strides[0] + c * shape_vec.strides[1];
    }

    if (b_boardcast_type == BOARDCAST_AXIS0)
    {
        b_batch_off = c * shape_mat.strides[1];
    }
    else if (b_boardcast_type == BOARDCAST_AXIS1)
    {
        b_batch_off = b * shape_mat.strides[0];
    }
    else if (b_boardcast_type == BOARDCAST_NONE)
    {
        b_batch_off = b * shape_mat.strides[0] + c * shape_mat.strides[1];
    }

    uint out_batch_off = b * shape_out.strides[0] + c * shape_out.strides[1];

    uint K = shape_vec.shapes[3];
    uint a_row_off = a_batch_off + h * shape_vec.strides[2];
    uint b_row_off = b_batch_off + w * shape_mat.strides[2];

    uint lane = gl_SubgroupInvocationID.x;
    ACC_DTYPE acc0 = ACC_DTYPE(0);
    ACC_DTYPE acc1 = ACC_DTYPE(0);
    // Second row: same (b,c,h), w+1. Validity checked before writing.
    uint w1 = w + 1;
    uint b_row_off1 = b_row_off + shape_mat.strides[2];
    uint a2_off = a_row_off;

    bool has_row1 = (w1 < shape_out.shapes[3]);

#ifdef _SUPPORT_16BIT_STORAGE
    // Vectorized path: strictly contiguous weights only — unit element
    // pitch AND row pitch exactly K (so both rows of the pair start at
    // multiples of 4 elements when K is a multiple of 4). Everything else
    // falls back to the scalar path below.
    // Vectorized path: strictly contiguous weights only — unit element
    // pitch AND row pitch exactly K (so both rows of the pair start at
    // multiples of 4 elements when K is a multiple of 4). The C side
    // guarantees this precondition before selecting the GEMV pipeline;
    // the check is kept here as a safety net.
    if (shape_vec.strides[3] == 1 && shape_mat.strides[3] == 1 && shape_mat.strides[2] == K && (K & 3u) == 0)
    {
        // Vectorized path: unit row pitch, four elements per load. The
        // activation f16vec4 each lane loads feeds BOTH weight rows.
        uint nvec4 = K / 4;
        uint i = lane;
        [[unroll]] for (; i + 2 * gl_SubgroupSize <= nvec4; i += 2 * gl_SubgroupSize)
        {
            f16vec4 v0 = in_vec_v4[(a_row_off + i * 4) / 4];
            f16vec4 v1 = in_vec_v4[(a_row_off + (i + gl_SubgroupSize) * 4) / 4];
            f16vec4 m00 = in_mat_v4[(b_row_off + i * 4) / 4];
            f16vec4 m10 = in_mat_v4[(b_row_off1 + i * 4) / 4];
            f16vec4 m01 = in_mat_v4[(b_row_off + (i + gl_SubgroupSize) * 4) / 4];
            f16vec4 m11 = in_mat_v4[(b_row_off1 + (i + gl_SubgroupSize) * 4) / 4];
            acc0 = ACC_DTYPE(dot(v0, m00)) + acc0;
            acc1 = ACC_DTYPE(dot(v0, m10)) + acc1;
            acc0 = ACC_DTYPE(dot(v1, m01)) + acc0;
            acc1 = ACC_DTYPE(dot(v1, m11)) + acc1;
        }
        for (; i < nvec4; i += gl_SubgroupSize)
        {
            f16vec4 v = in_vec_v4[(a_row_off + i * 4) / 4];
            f16vec4 m0 = in_mat_v4[(b_row_off + i * 4) / 4];
            f16vec4 m1 = in_mat_v4[(b_row_off1 + i * 4) / 4];
            acc0 = ACC_DTYPE(dot(v, m0)) + acc0;
            acc1 = ACC_DTYPE(dot(v, m1)) + acc1;
        }
        // Scalar tail for K % 4 != 0: iterate individual elements. One lane
        // per element (K - nvec4*4 < 4 <= subgroup size, so a single pass).
        for (uint k = nvec4 * 4 + lane; k < K; k += gl_SubgroupSize)
        {
            ACC_DTYPE v = ACC_DTYPE(in_vec[a_row_off + k]);
            ACC_DTYPE m0 = ACC_DTYPE(in_mat[b_row_off + k]);
            ACC_DTYPE m1 = ACC_DTYPE(in_mat[b_row_off1 + k]);
            acc0 = fma(v, m0, acc0);
            if (has_row1)
            {
                acc1 = fma(v, m1, acc1);
            }
        }
    }
    else
#endif
    {
        // Generic strided path (scalar loads, arbitrary row pitch).
        uint iter_stride = 4 * gl_SubgroupSize;
        uint i = 4 * lane;
        [[unroll]] for (; i + 4 <= K; i += iter_stride)
        {
            vec4 a0 = vec4(ACC_DTYPE(in_vec[a_row_off + (i + 0) * shape_vec.strides[3]]),
                           ACC_DTYPE(in_vec[a_row_off + (i + 1) * shape_vec.strides[3]]),
                           ACC_DTYPE(in_vec[a_row_off + (i + 2) * shape_vec.strides[3]]),
                           ACC_DTYPE(in_vec[a_row_off + (i + 3) * shape_vec.strides[3]]));
            vec4 m00 = vec4(ACC_DTYPE(in_mat[b_row_off + (i + 0) * shape_mat.strides[3]]),
                            ACC_DTYPE(in_mat[b_row_off + (i + 1) * shape_mat.strides[3]]),
                            ACC_DTYPE(in_mat[b_row_off + (i + 2) * shape_mat.strides[3]]),
                            ACC_DTYPE(in_mat[b_row_off + (i + 3) * shape_mat.strides[3]]));
            vec4 m10 = vec4(ACC_DTYPE(in_mat[b_row_off1 + (i + 0) * shape_mat.strides[3]]),
                            ACC_DTYPE(in_mat[b_row_off1 + (i + 1) * shape_mat.strides[3]]),
                            ACC_DTYPE(in_mat[b_row_off1 + (i + 2) * shape_mat.strides[3]]),
                            ACC_DTYPE(in_mat[b_row_off1 + (i + 3) * shape_mat.strides[3]]));
            acc0 = ACC_DTYPE(dot(a0, m00)) + acc0;
            acc1 = ACC_DTYPE(dot(a0, m10)) + acc1;
        }
        for (; i < K; i += gl_SubgroupSize)
        {
            ACC_DTYPE v = ACC_DTYPE(in_vec[a_row_off + i * shape_vec.strides[3]]);
            acc0 = fma(v, ACC_DTYPE(in_mat[b_row_off + i * shape_mat.strides[3]]), acc0);
            if (has_row1)
            {
                acc1 = fma(v, ACC_DTYPE(in_mat[b_row_off1 + i * shape_mat.strides[3]]), acc1);
            }
        }
    }

    // has_row1 is uniform across the subgroup (it depends only on the row
    // pair index), so both subgroupAdds execute uniformly.
    ACC_DTYPE v0 = subgroupAdd(acc0) * ACC_DTYPE(scale);
    ACC_DTYPE v1 = subgroupAdd(acc1) * ACC_DTYPE(scale);
    v0 = act == 1 ? v0 / (ACC_DTYPE(1.0) + exp(-v0)) : v0;
    v1 = act == 1 ? v1 / (ACC_DTYPE(1.0) + exp(-v1)) : v1;
    if (subgroupElect())
    {
        out_mat[out_batch_off + h * shape_out.strides[2] + w * shape_out.strides[3]] = OUT_DTYPE(v0);
        if (has_row1)
        {
            out_mat[out_batch_off + h * shape_out.strides[2] + w1 * shape_out.strides[3]] = OUT_DTYPE(v1);
        }
    }
}
