#version 450 core
#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#ifdef _SUPPORT_FLOAT16_ARITHMETIC
#extension GL_EXT_shader_subgroup_extended_types_float16 : require
#endif

#include "vkllm_shader_header.comp.h"

layout(binding = 0) readonly buffer in0_type
{
    DTYPE in_vec[];
};

layout(binding = 1) readonly buffer in1_type
{
    DTYPE in_mat[];
};

#ifdef _SUPPORT_16BIT_STORAGE
// Vectorized aliases over the same buffer: with a unit row pitch
// (strides[3] == 1) rows are consumed four elements per memory op.
layout(binding = 0) readonly buffer in0_type_v4
{
    f16vec4 in_vec_v4[];
};
layout(binding = 1) readonly buffer in1_type_v4
{
    f16vec4 in_mat_v4[];
};
#endif

layout(binding = 2) writeonly buffer out0_type
{
    DTYPE out_mat[];
};

layout(push_constant) uniform constants
{
    ShapeConstant shape_vec;
    ShapeConstant shape_mat;
    ShapeConstant shape_out;

    float scale;
    int act;
};

#define BOARDCAST_AXIS0 0
#define BOARDCAST_AXIS1 1
#define BOARDCAST_AXIS01 2
#define BOARDCAST_NONE 3

layout(constant_id = 0) const int a_boardcast_type = 0;
layout(constant_id = 1) const int b_boardcast_type = 0;

// One workgroup = (subgroup_size, NUM_ROWS, 1). Each y lane is a full
// subgroup computing a different output row; the two subgroups run in
// parallel on the same L2-resident activation strip. This doubles row
// throughput per workgroup versus one subgroup per row.
#define NUM_ROWS 2

void main()
{
    // Workgroup linear id -> first row of this group's row pair, in the
    // flattened [b, c, h, w] output space (w is the matrix row / N dim).
    uint wg = gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z;
    uint row_idx = wg * NUM_ROWS + gl_LocalInvocationID.y;

    uint n_total = shape_out.shapes[2] * shape_out.shapes[3];
    uint b = row_idx / (shape_out.shapes[1] * n_total);
    uint rem = row_idx - b * shape_out.shapes[1] * n_total;
    uint c = rem / n_total;
    uint hw = rem - c * n_total;
    uint h = hw / shape_out.shapes[3];
    uint w = hw - h * shape_out.shapes[3];

    if (b >= shape_out.shapes[0] || c >= shape_out.shapes[1] || h >= shape_out.shapes[2] ||
        w >= shape_out.shapes[3])
    {
        return;
    }

    uint a_batch_off = 0;
    uint b_batch_off = 0;
    if (a_boardcast_type == BOARDCAST_AXIS0)
    {
        a_batch_off = c * shape_vec.strides[1];
    }
    else if (a_boardcast_type == BOARDCAST_AXIS1)
    {
        a_batch_off = b * shape_vec.strides[0];
    }
    else if (a_boardcast_type == BOARDCAST_NONE)
    {
        a_batch_off = b * shape_vec.strides[0] + c * shape_vec.strides[1];
    }

    if (b_boardcast_type == BOARDCAST_AXIS0)
    {
        b_batch_off = c * shape_mat.strides[1];
    }
    else if (b_boardcast_type == BOARDCAST_AXIS1)
    {
        b_batch_off = b * shape_mat.strides[0];
    }
    else if (b_boardcast_type == BOARDCAST_NONE)
    {
        b_batch_off = b * shape_mat.strides[0] + c * shape_mat.strides[1];
    }

    uint out_batch_off = b * shape_out.strides[0] + c * shape_out.strides[1];

    uint K = shape_vec.shapes[3];
    uint a_row_off = a_batch_off + h * shape_vec.strides[2];
    uint b_row_off = b_batch_off + w * shape_mat.strides[2];

    uint ci = out_batch_off + h * shape_out.strides[2] + w * shape_out.strides[3];

    ACC_DTYPE acc = ACC_DTYPE(0);
    uint lane = gl_SubgroupInvocationID.x;

#ifdef _SUPPORT_16BIT_STORAGE
    // Vectorized path: requires unit row pitch so a f16vec4 load covers
    // four consecutive elements of one row. Each lane walks K in steps of
    // 4*subgroup with an unrolled pair (two f16vec4 per lane per iteration).
    if (shape_vec.strides[3] == 1 && shape_mat.strides[3] == 1)
    {
        uint nvec4 = K / 4;
        uint i = lane;
        [[unroll]] for (; i + gl_SubgroupSize < nvec4; i += 2 * gl_SubgroupSize)
        {
            f16vec4 v0 = in_vec_v4[(a_row_off + i * 4) / 4];
            f16vec4 m0 = in_mat_v4[(b_row_off + i * 4) / 4];
            f16vec4 v1 = in_vec_v4[(a_row_off + (i + gl_SubgroupSize) * 4) / 4];
            f16vec4 m1 = in_mat_v4[(b_row_off + (i + gl_SubgroupSize) * 4) / 4];
            acc = ACC_DTYPE(dot(v0, m0)) + acc;
            acc = ACC_DTYPE(dot(v1, m1)) + acc;
        }
        for (; i < nvec4; i += gl_SubgroupSize)
        {
            f16vec4 v = in_vec_v4[(a_row_off + i * 4) / 4];
            f16vec4 m = in_mat_v4[(b_row_off + i * 4) / 4];
            acc = ACC_DTYPE(dot(v, m)) + acc;
        }
        for (uint k = nvec4 * 4 + lane; k < K; k += gl_SubgroupSize)
        {
            acc = acc + ACC_DTYPE(in_vec[a_row_off + k]) * ACC_DTYPE(in_mat[b_row_off + k]);
        }
    }
    else
#endif
    {
        // Generic strided path (scalar loads, arbitrary row pitch).
        uint iter_stride = 4 * gl_SubgroupSize;
        uint i = 4 * lane;
        [[unroll]] for (; i + 4 <= K; i += iter_stride)
        {
            vec4 a = vec4(ACC_DTYPE(in_vec[a_row_off + i * shape_vec.strides[3]]),
                          ACC_DTYPE(in_vec[a_row_off + (i + 1) * shape_vec.strides[3]]),
                          ACC_DTYPE(in_vec[a_row_off + (i + 2) * shape_vec.strides[3]]),
                          ACC_DTYPE(in_vec[a_row_off + (i + 3) * shape_vec.strides[3]]));
            vec4 b = vec4(ACC_DTYPE(in_mat[b_row_off + i * shape_mat.strides[3]]),
                          ACC_DTYPE(in_mat[b_row_off + (i + 1) * shape_mat.strides[3]]),
                          ACC_DTYPE(in_mat[b_row_off + (i + 2) * shape_mat.strides[3]]),
                          ACC_DTYPE(in_mat[b_row_off + (i + 3) * shape_mat.strides[3]]));
            acc = ACC_DTYPE(dot(a, b)) + acc;
        }
        for (; i < K; i += gl_SubgroupSize)
        {
            acc = fma(ACC_DTYPE(in_vec[a_row_off + i * shape_vec.strides[3]]),
                      ACC_DTYPE(in_mat[b_row_off + i * shape_mat.strides[3]]), acc);
        }
    }

    ACC_DTYPE v = subgroupAdd(acc) * ACC_DTYPE(scale);
    v = act == 1 ? v / (ACC_DTYPE(1.0) + exp(-v)) : v;
    if (subgroupElect())
    {
        out_mat[ci] = OUT_DTYPE(v);
    }
}
